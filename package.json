{
  "name": "deony",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:cognito\"",
    "dev:db": "java -Djava.library.path=./tools/dynamodb_local/DynamoDBLocal_lib -jar ./tools/dynamodb_local/DynamoDBLocal.jar -sharedDb -dbPath ./local-data/dynamodb -port 8000",
    "dev:cognito": "cognito-local --port 9229 --db ./local-data/cognito",
    "dev:api": "tsx watch server/dev-server.ts",
    "dev:web": "vite",
    "dev:setup": "tsx server/scripts/create-tables.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-ssm": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.162",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/s3rver": "^3.7.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "cognito-local": "^5.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "s3rver": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
